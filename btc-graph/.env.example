# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL
DATABASE_URL=postgresql://btc_user:btc_pass@localhost:5432/btc_graph

# Redis
REDIS_URL=redis://localhost:6379/0

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=btc_neo4j_pass

# ─── Мультимонетность ────────────────────────────────────────────────────────
# Каталог профилей калибровки на монету. Реестр профилей = whitelist монет:
# монета без своего YAML считается базовой калибровкой и получает
# warning-флаг unknown_symbol_profile.
PROFILES_DIR=config/symbols

# POST /config/reload перечитывает профили без рестарта и меняет поведение
# скоринга на лету. API работает без аутентификации, поэтому по умолчанию
# ручка выключена — включать только локально.
ENABLE_CONFIG_RELOAD=false

# ─── Публичное API чтения (/api/v1/*) ────────────────────────────────────────
# Ключи доступа: список через запятую, элемент — `метка:ключ` либо голый ключ.
# Метка нужна только логам, чтобы отличать интеграторов друг от друга.
#
#   API_KEYS=bot:9f3c...,dashboard:71ae...
#
# Пустое значение — не «пускать всех», а «API не настроено»: ручки /api/v1/*
# отвечают 503. Ключ закрывает ТОЛЬКО чтение сохранённых оценок; /evaluate/*
# и остальное по-прежнему рассчитаны на петлю и прокси перед ней.
# Сгенерировать: openssl rand -hex 32
API_KEYS=
