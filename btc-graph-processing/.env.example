# ─── Хранилище (общий стек с btc-graph) ─────────────────────────────────────
# Локальный запуск: localhost. В docker-compose адреса перекрываются именами
# сервисов (postgres/redis/neo4j) из сети btc-graph.
DATABASE_URL=postgresql://btc_user:btc_pass@localhost:5432/btc_graph
REDIS_URL=redis://localhost:6379/1
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=btc_neo4j_pass

# Схема, в которой живут таблицы processing. Таблицы btc-graph (candidates,
# candidate_events) остаются в public и трогаются только через его pipeline.
PG_SCHEMA=processing

# ─── Связь с btc-graph ──────────────────────────────────────────────────────
# direct — импортировать пакет btc-graph и писать в БД напрямую его pipeline
#          (скорер, валидатор, дедуп и запись в Neo4j при этом работают);
# http   — слать пачками на POST /evaluate/batch;
# none   — ничего не отправлять, только копить в processing.candidates.
SINK_MODE=direct
BTC_GRAPH_PATH=/Volumes/work/crypto-graph/btc-graph
BTC_GRAPH_URL=http://localhost:8000
# Redis самого btc-graph (его дедуп и каналы candidates:strong:*)
BTC_GRAPH_REDIS_URL=redis://localhost:6379/0
SINK_USE_LLM=false
SINK_BATCH_SIZE=200
# Порог качества для отправляемых кандидатов. ПУСТО (штатно) — порог берётся
# из профиля каждой монеты в btc-graph (config/symbols/*.yaml, batch.min_quality_score),
# то есть работает калибровка. Число — единая линейка на весь батч поверх
# профилей; годится для разовых экспериментов, но не для регулярной работы.
SINK_MIN_QUALITY=

# ─── Уведомления (вебхуки о кандидатах) ─────────────────────────────────────
# Правила «куда и что слать» живут в БД и правятся в админке (страница
# «Уведомления») — их здесь нет намеренно: менять адрес получателя перезапуском
# процесса неприемлемо. Здесь только механика доставки.
# Формат JSON для принимающей системы — docs/notifications.md.
#
# Общий рубильник: false выключает рассылку, не трогая настроенные правила.
NOTIFY_ENABLED=true
# Сколько ждать ответа одного получателя. Прогон этого не ждёт (отправка идёт
# фоновым потоком), но зависший адрес не должен тормозить очередь.
NOTIFY_TIMEOUT=5.0
NOTIFY_WORKERS=2
# Потолок очереди. Переполнение = честная потеря с отметкой `dropped` в журнале
# доставок; копить задания в памяти прогона неограниченно хуже.
NOTIFY_QUEUE_SIZE=2000
# Сколько прогон ждёт разбора очереди ПЕРЕД выходом. Без этого ожидания
# крон-процесс (`make live`) убил бы фоновые потоки вместе с неотправленным.
NOTIFY_FLUSH_SECONDS=30
# ПРЕДОХРАНИТЕЛЬ. Кандидат старше этого возраста не отправляется вовсе.
# Полный прогон train выпускает сотни тысяч кандидатов начиная с 2017 года —
# без окна первый же такой прогон с отправкой разослал бы их все.
NOTIFY_MAX_CANDIDATE_AGE_MIN=180
# Хранение журнала доставок. Журнал заодно защищает от повторной отправки
# (ключ «правило + кандидат»), поэтому ниже суток опускать нельзя.
NOTIFY_RETENTION_DAYS=30

# ─── Данные ─────────────────────────────────────────────────────────────────
# SYMBOL — монета ПО УМОЛЧАНИЮ для одиночных команд (train, live, ingest без
# флагов) и стартовая монета селектора в админке. Полный список пар живёт
# в btcproc/symbols.py: дата листинга и переопределения порогов — знание
# о рынке, оно версионируется вместе с кодом. Значение обязано присутствовать
# в реестре, иначе админка не стартует.
#   несколько монет: python3 -m btcproc.cli train --symbol ETHUSDT --symbol SOLUSDT
#   все активные:    make train-all / make live-all
SYMBOL=BTCUSDT
BASE_TIMEFRAME=15m
CONTEXT_TIMEFRAMES=1h,4h,1d
# Дефолт для монет, у которых history_start не задан в реестре.
# Спека монеты его перекрывает — иначе ingest альткоина упирался бы
# в полсотни 404 за месяцы до листинга.
HISTORY_START=2017-08-01
HORIZON=24h
DATA_DIR=./data
# Откуда добирается свежий хвост баров (месячные дампы качаются с другого
# хоста и от этого не зависят). api.binance.com отвечает 451 Unavailable For
# Legal Reasons из ряда юрисдикций, в частности из США — на таком хосте live
# не работает вовсе. Замена: https://data-api.binance.vision/api/v3/klines —
# тот же публичный /api/v3, без ключей, отвечает отовсюду.
BINANCE_REST_URL=https://api.binance.com/api/v3/klines

# ─── Источники сигнала ──────────────────────────────────────────────────────
# У КАЖДОГО источника два флага, и это не дублирование, а разная цена.
#
#   <ИСТОЧНИК>_ENABLED          — контекстные атомы. Бесплатно и обратимо:
#     в маску не входят, event_block_id не меняют, переобучения не требуют.
#     live со старой моделью просто пишет их в bar_events.context_atoms.
#   <ИСТОЧНИК>_FEATURES_ENABLED — величины в векторе признаков. Дорого:
#     метка набора меняется (v1 → v1+smc), нужен полный train, group_id
#     перенумеровываются, накопленный граф Neo4j сносится.
#
# Порядок ввода источника с ВНЕШНИМИ данными жёсткий и стоил двух инцидентов
# (журнал 34.10): сначала код, потом наполнение таблицы отдельной командой,
# и только потом флаг. Наоборот — пустая таблица даёт сплошной False на
# свежих барах без единой ошибки в логе.
#
# Все три источника прошли механизм docs/extending_features.md целиком.
# Признаки не заведены НИ У ОДНОГО — не по осторожности, а по замерам:
# SMC (журнал 22.5) и Fear & Greed (34) не предсказывают ни направление, ни
# размах; у деривативов (36) гейт по размаху прошла одна величина из шести,
# но не прошла гейт по градации. Атомы включены не потому, что работают, а
# потому что размечают историю даром — «зона ликвидности», «крайний страх»,
# «набор лонгов» на узле графа и в инспекторе бара.

# Smart Money: считается из самих баров, внешних данных не требует.
SMC_ENABLED=true
SMC_FEATURES_ENABLED=false

# Fear & Greed: общерыночный дневной ряд из external_daily.
# Требует крона `fetch-external` — без него атомы молча всегда False.
FGI_ENABLED=true
FGI_FEATURES_ENABLED=false

# Деривативные метрики Binance USD-M (ОИ, long/short ratio, тейкеры).
# ПОМОНЕТНЫЙ ряд в deriv_metrics; требует крона `ingest-metrics`.
DERIV_ENABLED=true
DERIV_FEATURES_ENABLED=false

# ПРЕДОХРАНИТЕЛЬ на включение признаков источника. Сборка вектора
# заканчивается общим dropna по всем колонкам, а признаки внешнего источника
# существуют не на всей истории монеты: у деривативов метрики BTC начинаются
# в 2020-09 при барах с 2017-08. Без предохранителя включение флага молча
# обучило бы модель на трети истории. Считается потеря строк СВЕРХ базового
# набора; превышение — ошибка с именем виновного источника, а не
# предупреждение. Поднимать осознанно и временно, ради разового эксперимента.
FEATURES_MAX_SOURCE_ROW_LOSS=0.02

# ─── Пороги кластеризации ───────────────────────────────────────────────────
# Размер группы, ниже которого дробить нельзя:
#     max(STATES_MIN_GROUP_SIZE, round(STATES_MIN_GROUP_SHARE * число баров))
# Доля — основной механизм (на истории BTC даёт ~750, то есть исходную
# калибровку), абсолютное число — пол для монет с короткой историей.
# Точечно на монету это переопределяется в btcproc/symbols.py (states_overrides).
STATES_MIN_GROUP_SHARE=0.0025
STATES_MIN_GROUP_SIZE=300

# ─── Порог дробления состояний (gap statistic) ──────────────────────────────
# Референсов несколько, а порог выражен в их собственных сигмах. Абсолютный
# порог (STATES_SPLIT_GAIN, до 2026-08-11) зависел от размерности: константа,
# откалиброванная на 32 признаках, в 44 означала другую строгость — и граф
# обрушивали двенадцать новых признаков ЛЮБОЙ природы, включая чистый шум.
# 2.0 — результат калибровки по устойчивости числа состояний между окнами
# разной длины (scripts/calibrate_split_gain.py), а не подгонка под прежнее
# число состояний.
STATES_SPLIT_REFERENCE_DRAWS=10
STATES_SPLIT_GAIN_SIGMA=2.0

# ─── Админка ────────────────────────────────────────────────────────────────
# Обязательны. Сервис не стартует с пустыми или дефолтными значениями.
ADMIN_USER=admin
ADMIN_PASSWORD=ЗАМЕНИ_МЕНЯ_длинным_паролем
# openssl rand -hex 32
ADMIN_SECRET_KEY=ЗАМЕНИ_МЕНЯ_на_вывод_openssl_rand_hex_32
# Сколько прогонов админка ведёт одновременно. Прогоны разных монет независимы,
# но идут BackgroundTasks в её процессе: каждый занимает ядро на кластеризации
# и заметный кусок памяти.
ADMIN_MAX_CONCURRENT_RUNS=2
ADMIN_SESSION_TTL=43200
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_SECONDS=900
# Пустое значение = доступ с любого IP. Иначе список через запятую: 127.0.0.1,10.0.0.0/8
ADMIN_IP_ALLOWLIST=
# true — ТОЛЬКО если перед админкой стоит прокси (nginx), перезаписывающий
# X-Forwarded-For. Без прокси заголовок ставит сам клиент: он обойдёт
# ADMIN_IP_ALLOWLIST и обнулит счётчик неудачных входов фейковым адресом.
ADMIN_TRUST_PROXY=false
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8100

# ─── Монитор ресурсов хоста (страница «Сервер») ──────────────────────────────
# Замеры пишет отдельный сервис `btcproc hostmon` в SQLite-файл. Файл, а не
# Postgres: монитор нужен именно тогда, когда docker-стек лежит, и зависеть от
# него не имеет права. Путь по умолчанию — <корень репозитория>/logs/hostmon.sqlite,
# ВНЕ каталогов подпроектов: их выкатка гонит rsync --delete.
# HOSTMON_DB=/opt/crypto-graph/logs/hostmon.sqlite
HOSTMON_INTERVAL_SECONDS=60
HOSTMON_KEEP_DAYS=30
# Точки монтирования под наблюдением, через запятую. Первая — корневая.
HOSTMON_MOUNTS=/
# Опрос docker (статус и потребление контейнеров). Нужны права на его сокет.
HOSTMON_DOCKER=true
HOSTMON_TOP_PROCESSES=12

# ─── Уведомления о нагрузке в Telegram ──────────────────────────────────────
# Токен — у @BotFather, chat_id — id личного чата или группы (у групп он
# отрицательный). Не заданы — алерты не отправляются, страница «Сервер» об этом
# прямо говорит. Проверка канала: make hostmon-test-telegram
HOSTMON_ALERTS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Пока проблема держится, напоминание уходит не чаще этого окна (первое
# сообщение — сразу). Это главный предохранитель от спама.
HOSTMON_ALERT_COOLDOWN_MINUTES=5
# «Отпустило» считается не по возврату под порог, а по возврату ниже
# «порог − гистерезис»: метрика, топчущаяся у 90%, иначе слала бы пару
# «сработало/отпустило» на каждом замере.
HOSTMON_ALERT_HYSTERESIS=5
# Сколько замеров подряд за порогом нужно шумным метрикам (CPU, load). Диск и
# память заполняются монотонно, им выдержка не нужна.
HOSTMON_ALERT_SUSTAIN_TICKS=5
HOSTMON_ALERT_DISK_PCT=90
HOSTMON_ALERT_DISK_CRITICAL_PCT=96
HOSTMON_ALERT_MEM_PCT=90
# Swap ниже остальных не случайно: на этой машине он не «резерв памяти», а
# ранний признак близкого OOM — расчёт признаков без swap уже ловил killer.
HOSTMON_ALERT_SWAP_PCT=60
HOSTMON_ALERT_CPU_PCT=90
HOSTMON_ALERT_LOAD_PER_CORE=2
HOSTMON_ALERT_NOTIFY_RECOVERY=true
